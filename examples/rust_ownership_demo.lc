// ==============================================================================
//  Lcode 演示: Rust 风格内存管理、所有权移动与 RAII 自动析构
// ==============================================================================

// 辅助函数：按引用借用访问资源 (不夺走所有权)
fn inspect_buffer(buf: int) -> void {
    p("  [借用检查 &buf]: 正在安全读取句柄", buf);
    let v0 = read(buf, 0);
    let v1 = read(buf, 1);
    p("  --> 数据内容: [0] =", v0, ", [1] =", v1);
}

// 辅助函数：工厂函数，分配资源并将所有权返回逃逸给调用方
fn factory_allocate() -> int {
    p("  [资源工厂]: 正在分配堆内存资源 (大小 8 字长)...");
    let h = alloc(8);
    write(h, 0, 8888);
    write(h, 1, 9999);
    ret h; // 所有权通过 return 逃逸转移，不被当前函数作用域提前 drop
}

fn main() -> void {
    p("================================================================================");
    p("🦀 Lcode - 深度对齐 Rust 内存管理与所有权模型演示");
    p("================================================================================");

    // --------------------------------------------------------------------------
    // 阶段 1: RAII 作用域自动析构 (Scope-based Deterministic Drop)
    // --------------------------------------------------------------------------
    p("\n[阶段 1] 演示 RAII 作用域自动析构 (Zero-leak Scope Drop):");
    {
        p("  --> 进入局部代码块 { ... }");
        let local_res = alloc(32);
        write(local_res, 0, 100);
        write(local_res, 1, 200);
        p("  --> 成功在块内申请局部句柄:", local_res);
        stats();
        p("  --> 即将离开局部代码块作用域...");
    }
    p("  <-- 已离开局部代码块作用域！");
    let leaks_stage1 = check_leaks();
    p("  --> 作用域析构后泄漏检查结果: leaks =", leaks_stage1);
    assert(leaks_stage1 == 0, "RAII 代码块退出时必须自动析构释放全部持有的堆资源！");
    p("  ✓ [验证成功]: RAII 零泄漏自动清理生效！");

    // --------------------------------------------------------------------------
    // 阶段 2: 引用借用 (&) 与数据读写
    // --------------------------------------------------------------------------
    p("\n[阶段 2] 演示 Rust 引用借用 (&) 机制:");
    let orig = alloc(16);
    write(orig, 0, 12345);
    write(orig, 1, 67890);
    p("  --> 创建持有原始资源的句柄:", orig);

    // 通过 &orig 传入借用
    inspect_buffer(&orig);

    // 借用结束后，orig 所有权依然有效！
    let check_val = read(orig, 0);
    p("  --> 借用返回后再次读取 orig 数据:", check_val);
    assert(check_val == 12345, "引用借用不应改变所有权！");
    p("  ✓ [验证成功]: 借用检查确保所有权完整保留！");

    // --------------------------------------------------------------------------
    // 阶段 3: 返回值所有权逃逸 (Ownership Escape) 与显式 drop()
    // --------------------------------------------------------------------------
    p("\n[阶段 3] 演示返回值所有权逃逸与显式 drop():");
    let my_res = factory_allocate();
    p("  --> 主函数成功接收逃逸所有权句柄:", my_res);
    let f_val0 = read(my_res, 0);
    let f_val1 = read(my_res, 1);
    p("  --> 验证逃逸资源数据: [0] =", f_val0, ", [1] =", f_val1);
    assert(f_val0 == 8888 && f_val1 == 9999, "逃逸数据完整性校验通过");

    p("  --> 执行显式 drop(orig) 释放资源...");
    drop(orig);

    p("  --> 执行显式 drop(my_res) 释放资源...");
    drop(my_res);

    // --------------------------------------------------------------------------
    // 阶段 4: 全系统终态内存健康检查
    // --------------------------------------------------------------------------
    p("\n[阶段 4] 全系统内存终态健康诊断:");
    stats();
    let final_leaks = check_leaks();
    p("  --> 最终活动内存泄漏数:", final_leaks);
    assert(final_leaks == 0, "系统终态必须达到绝对零泄漏！");

    p("\n================================================================================");
    p("🎉 恭喜！Rust 所有权机制、借用检查、RAII 自动析构与显式 drop 全部圆满验证！");
    p("================================================================================");
}
