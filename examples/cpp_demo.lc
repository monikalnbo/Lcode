// ==============================================================================
//  Lcode 内置高性能 C++ 核心库演示程序 (examples/cpp_demo.lc)
// ==============================================================================

import "std/cpp/core";
import "std/math";

fun main() -> void {
    p("==================================================");
    p("⚡ Lcode 内置现代 C++17 核心库加速演示");
    p("==================================================");

    // 1. C++ 极速开方
    let sq = cpp_fast_sqrt(144.0);
    p("cpp_fast_sqrt(144.0) =", sq);

    // 2. C++ 快速幂
    let pw = cpp_pow(2.0, 10.0);
    p("cpp_pow(2.0, 10.0) =", pw);

    // 3. C++ 绝对值
    let ab = cpp_abs(-999);
    p("cpp_abs(-999) =", ab);

    // 4. C++ 欧几里得最大公约数 (GCD)
    let g = cpp_gcd(120, 45);
    p("cpp_gcd(120, 45) =", g);

    // 5. C++ 快速递推斐波那契数
    let fib = cpp_fibonacci(20);
    p("cpp_fibonacci(20) =", fib);

    // 6. C++ 素数检测
    let prime = cpp_is_prime(97);
    p("cpp_is_prime(97) =", prime);

    p("\n✓ C++ 核心库在 Lcode 解释执行器与 C++ 转译器中均可无缝工作！");
}
