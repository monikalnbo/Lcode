// ==============================================================================
//  Lcode 标准字符串库 (std/str)
//  提供高效后端字符串长度、包含判断、切分、首尾空白清理与大小写转换
// ==============================================================================

// 获取字符串字符长度
fn length(s: string) -> int {
    return str_len(s);
}

// 检查主串是否包含子串
fn contains(s: string, substr: string) -> bool {
    return str_contains(s, substr);
}

// 根据分隔符切分字符串，返回字符串数组
fn split(s: string, sep: string) -> array {
    return str_split(s, sep);
}

// 去除字符串两侧空白符
fn trim(s: string) -> string {
    return str_trim(s);
}

// 转换为大写
fn to_upper(s: string) -> string {
    return str_upper(s);
}

// 转换为小写
fn to_lower(s: string) -> string {
    return str_lower(s);
}
