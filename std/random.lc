// ==============================================================================
//  Lcode 标准随机数生成库 (std/random)
//  提供伪随机整数区间采样与浮点概率生成
// ==============================================================================

// 生成闭区间 [min_val, max_val] 内的随机整数
fn rand_int(min_val: int, max_val: int) -> int {
    return random_int(min_val, max_val);
}

// 生成区间 [0.0, 1.0) 内的随机浮点数
fn rand_float() -> float {
    return random_float();
}
